From 0000000000000000000000000000000000000017
Subject: [PATCH] population_vendor_count/rotation/callouts: mod vendor settings

A mod vendor's count, rotation and callouts live in YAML, which a player
can't change from the app. Mod settings do reach scripts, so these let a
mod's OnInit hand its settings to the engine, per VendorKey prefix. They do
nothing unless a script calls them.

--- a/src/custom/script.inc
+++ b/src/custom/script.inc
@@ -238,3 +238,39 @@
 	script_pushstrcopy(st, csv.c_str());
 	return SCRIPT_CMD_SUCCESS;
 }
+
+/*==========================================
+ * Mod vendor settings. Each applies to the mod vendors whose VendorKey starts
+ * with the prefix, and a mod calls them from OnInit with its own settings:
+ *
+ * population_vendor_count("<prefix>", <total>)
+ *   How many shells those vendors keep in total, split across their Spawns
+ *   blocks by the YAML counts. A negative total goes back to the YAML.
+ * population_vendor_rotation("<prefix>", <minutes>)
+ *   How long a stall stays before another takes its place (0 = never).
+ *   A negative value goes back to the YAML.
+ * population_vendor_callouts("<prefix>", <on>{, <min seconds>{, <max seconds>}})
+ *   Whether those stalls shout their wares, and how long each waits between
+ *   shouts. Leaving the seconds out keeps the YAML pace.
+ *
+ *   population_vendor_count "my-mod/", callfunc("F_ModSetting", "my-mod", "vendors", 20);
+ *------------------------------------------*/
+BUILDIN_FUNC(population_vendor_count)
+{
+	population_engine_set_mod_vendor_total(script_getstr(st, 2), script_getnum(st, 3));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_vendor_rotation)
+{
+	population_engine_set_mod_vendor_rotation(script_getstr(st, 2), script_getnum(st, 3));
+	return SCRIPT_CMD_SUCCESS;
+}
+
+BUILDIN_FUNC(population_vendor_callouts)
+{
+	const int min_sec = script_hasdata(st, 4) ? script_getnum(st, 4) : 0;
+	const int max_sec = script_hasdata(st, 5) ? script_getnum(st, 5) : min_sec;
+	population_engine_set_mod_vendor_callouts(script_getstr(st, 2), script_getnum(st, 3), min_sec, max_sec);
+	return SCRIPT_CMD_SUCCESS;
+}
--- a/src/custom/script_def.inc
+++ b/src/custom/script_def.inc
@@ -19,3 +19,6 @@
 BUILDIN_DEF(population_arena_start, "si????"),
 BUILDIN_DEF(population_arena_stop,  "s"),
 BUILDIN_DEF(population_arena_jobs,  ""),
+BUILDIN_DEF(population_vendor_count, "si"),
+BUILDIN_DEF(population_vendor_rotation, "si"),
+BUILDIN_DEF(population_vendor_callouts, "si??"),
