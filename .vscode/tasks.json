{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Patch webclient",
			"detail": "Apply patches/client/* to vendor/roBrowserLegacy (extension bridge, hooks, lockfile). Without this the build has no api.targeting/api.server and mods that need them go inert.",
			"type": "process",
			"windows": {
				"command": "wsl.exe",
				"args": ["--cd", "${workspaceFolder}", "--", "bash", "scripts/patch-client.sh"]
			},
			"linux": {
				"command": "bash",
				"args": ["scripts/patch-client.sh"]
			},
			"osx": {
				"command": "bash",
				"args": ["scripts/patch-client.sh"]
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Build webclient",
			"detail": "npm run build:all in vendor/roBrowserLegacy",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build:all"],
			"options": {
				"cwd": "${workspaceFolder}/vendor/roBrowserLegacy"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "Deploy webclient",
			"detail": "Mirror vendor/roBrowserLegacy/dist/Web into %APPDATA%\\Ragnarok Offline\\runtime\\vendor\\roBrowserLegacy\\dist\\Web",
			"type": "process",
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy", "Bypass",
					"-Command",
					"$dest = Join-Path $env:APPDATA 'Ragnarok Offline\\runtime\\vendor\\roBrowserLegacy\\dist\\Web'; New-Item -ItemType Directory -Force -Path $dest | Out-Null; robocopy 'vendor\\roBrowserLegacy\\dist\\Web' $dest /MIR /NFL /NDL /NP; if ($LASTEXITCODE -ge 8) { exit $LASTEXITCODE } else { exit 0 }"
				]
			},
			"linux": {
				"command": "bash",
				"args": [
					"-c",
					"dest=\"${APPDATA:-$HOME/.config}/Ragnarok Offline/runtime/vendor/roBrowserLegacy/dist/Web\"; mkdir -p \"$dest\" && rsync -a --delete vendor/roBrowserLegacy/dist/Web/ \"$dest/\""
				]
			},
			"osx": {
				"command": "bash",
				"args": [
					"-c",
					"dest=\"$HOME/Library/Application Support/Ragnarok Offline/runtime/vendor/roBrowserLegacy/dist/Web\"; mkdir -p \"$dest\" && rsync -a --delete vendor/roBrowserLegacy/dist/Web/ \"$dest/\""
				]
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Build and Deploy",
			"detail": "Patch, build, and copy the webclient to the runtime target directory",
			"dependsOrder": "sequence",
			"dependsOn": ["Patch webclient", "Build webclient", "Deploy webclient"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
