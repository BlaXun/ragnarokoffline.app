+/**
+ * Base level as a skill's damage may read it. With the `skill_damage_level`
+ * extension on, a player's level counts up to the extension's base_level and
+ * no further; off (default), this is status_get_lv. Monsters and other
+ * units always give their own level.
+ * @param bl: Object whose level a damage formula reads
+ * @return Level for the formula
+ */
+int32 status_get_lv_dmg(const block_list* bl) {
+	int32 lv = status_get_lv(bl);
+
+	if (bl != nullptr && bl->type == BL_PC && extension_enabled("skill_damage_level")) {
+		lv = min(lv, static_cast<int32>(extension_int("skill_damage_level", "base_level", lv)));
+	}
+
+	return lv;
+}
+
+/**
+ * Job level as a skill's damage may read it. With the `skill_damage_level`
+ * extension on, every player counts as the extension's job_level; off
+ * (default), this is the player's own job level.
+ * @param sd: Player (may be nullptr)
+ * @param fallback: Value for a unit that is not a player
+ * @return Job level for the formula
+ */
+int32 status_get_joblv_dmg(const map_session_data* sd, int32 fallback) {
+	if (sd == nullptr) {
+		return fallback;
+	}
+
+	if (extension_enabled("skill_damage_level")) {
+		return static_cast<int32>(extension_int("skill_damage_level", "job_level", sd->status.job_level));
+	}
+
+	return sd->status.job_level;
+}
